{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adeptus Inquisition event V1",
  "type": "object",
  "required": [
    "event_id",
    "trigger",
    "objective",
    "constraints",
    "contract",
    "milestone",
    "branch",
    "artifacts",
    "reviews",
    "issues",
    "authorization",
    "baseline"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "enum": [
        "TERMINAL_FAILURE",
        "MAJOR_MILESTONE"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "id",
        "approved",
        "criteria"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "approved": {
          "const": true
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "test"
            ]
          }
        }
      }
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "object",
          "required": [
            "repository",
            "commit"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "root_cause",
          "root_key",
          "branch_attempts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "root_cause": {
            "type": "string"
          },
          "root_key": {
            "type": "string"
          },
          "branch_attempts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": [
        "repositories",
        "actions"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "skill_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "skill_sha256": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
